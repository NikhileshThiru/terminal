# Copy this file to .env and fill in values. .env is gitignored.
# Every key below is a free signup — no credit card, no SSN.

# === LLM providers (Phase 4) ===
# Gemini: free, no credit card. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq: free, no card. https://console.groq.com/keys (key starts with gsk_)
GROQ_API_KEY=
# (No Anthropic provider, by design: no free tier.)

# === Market data (Phase 2) ===
# Alpaca paper account, no SSN, no credit card. https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Finnhub free tier. https://finnhub.io/dashboard
FINNHUB_API_KEY=

# FRED. https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# SEC EDGAR has no key but requires a User-Agent in this format:
SEC_USER_AGENT=Terminal Research/0.1 (your-email@example.com)

# === Infrastructure ===
# For a local `uvicorn` run. docker-compose overrides these (and sets
# EVENT_BUS=redis + INGESTION_MODE=external) for the containers.
DATABASE_URL=postgresql+psycopg://terminal:terminal@localhost:5432/terminal
REDIS_URL=redis://localhost:6379/0

# === App config ===
LOG_LEVEL=INFO
ENVIRONMENT=development
# Comma-separated list of tickers prioritized in the UI (NOT a discovery gate)
WATCHLIST=AAPL,MSFT,NVDA,AMD,GOOGL,META,AMZN,TSLA

# === LLM routing (config-driven; see docs/decisions/ADR-0006) ===
# Each step walks an ordered chain: the primary below, then its fallbacks.
# Free quotas are per model (Gemini ≈ 20 requests/day/model, Groq 1,000/day
# and 8K tokens/minute per model), so extra models = extra capacity.
LLM_TRIAGE_PROVIDER=groq
LLM_TRIAGE_MODEL=openai/gpt-oss-20b
# LLM_TRIAGE_FALLBACKS=groq:openai/gpt-oss-120b,gemini:gemini-3.1-flash-lite
LLM_THESIS_PROVIDER=gemini
LLM_THESIS_MODEL=gemini-2.5-flash
# Groq can't do theses (one tool-calling request > its 8K tokens/minute).
# LLM_THESIS_FALLBACKS=gemini:gemini-3.5-flash,gemini:gemini-3.7-flash,gemini:gemini-3.6-flash,gemini:gemini-3-flash-preview,gemini:gemini-3.8-flash,gemini:gemini-2.5-flash-lite
# Reactive theses per trading day (keeps quota for scheduled catalysts).
# AUTONOMOUS_MAX_REACTIVE_THESES_PER_DAY=4

# === Notifications (Step 9.1) ===
# Discord webhook for phone alerts on new theses + paper trade opens/closes.
# Server Settings → Integrations → Webhooks → New Webhook → Copy URL. Leave
# blank to disable; the funnel runs identically either way.
# DISCORD_WEBHOOK_URL=
